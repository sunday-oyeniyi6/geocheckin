# Base de données (PostgreSQL + PostGIS)
POSTGRES_USER=geocheckin
POSTGRES_PASSWORD=geocheckin
POSTGRES_DB=geocheckin
POSTGRES_PORT=5433
DATABASE_URL=postgresql://geocheckin:geocheckin@localhost:5433/geocheckin?schema=public

# Backend (NestJS)
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Session (JWT dans un cookie httpOnly)
# Générer un secret : openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_TTL=900

# Limitation de débit sur /auth/login et POST /volunteers
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
